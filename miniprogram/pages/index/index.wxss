page { background: #f7f5f0; }
.page { padding: 38rpx 32rpx 112rpx; color: #29352e; }
.hero { padding: 26rpx 8rpx 28rpx; }
.eyebrow { color: #7c967f; font-size: 20rpx; letter-spacing: 6rpx; }
.title { margin-top: 10rpx; font-size: 52rpx; font-weight: 650; }
.subtitle { margin-top: 8rpx; color: #788178; font-size: 26rpx; }
.connecting { margin-top: 38rpx; padding: 40rpx; color: #89948b; font-size: 27rpx; text-align: center; }
.current-card { position: relative; overflow: hidden; margin-top: 12rpx; padding: 38rpx; border-radius: 30rpx; color: #fff; background: linear-gradient(145deg, #527a60 0%, #345942 100%); box-shadow: 0 18rpx 40rpx rgba(44,86,57,.18); }
.current-card::after { position: absolute; top: -92rpx; right: -90rpx; width: 270rpx; height: 270rpx; border: 1rpx solid rgba(255,255,255,.12); border-radius: 50%; content: ''; pointer-events: none; }
.current-top { display: flex; justify-content: space-between; align-items: center; gap: 16rpx; }
.current-label { color: #d8e5d9; font-size: 24rpx; }
.current-tag { padding: 8rpx 18rpx; border-radius: 30rpx; background: rgba(255,255,255,.15); color: #fff; font-size: 21rpx; }
.current-name { margin-top: 12rpx; font-size: 42rpx; font-weight: 600; }
.current-owner { margin-top: 12rpx; color: #e0ebe1; font-size: 24rpx; }
.current-hint { margin-top: 12rpx; color: #e0ebe1; font-size: 23rpx; line-height: 1.5; }
.quick-summary { display: flex; justify-content: space-between; gap: 12rpx; margin-top: 30rpx; padding-top: 22rpx; border-top: 1rpx solid rgba(255,255,255,.25); }
.quick-summary view { display: flex; flex-direction: column; gap: 8rpx; min-width: 0; }
.quick-summary text:first-child { color: #d8e5d9; font-size: 22rpx; }
.quick-summary text:last-child { font-size: 25rpx; font-weight: 600; font-variant-numeric: tabular-nums; }
.quick-loading { margin-top: 26rpx; padding-top: 22rpx; border-top: 1rpx solid rgba(255,255,255,.22); color: #d8e5d9; font-size: 23rpx; }
.primary-button { margin-top: 32rpx; min-height: 88rpx; border-radius: 16rpx; color: #395940; background: #fff; font-weight: 600; font-size: 28rpx; }
.card { margin-top: 24rpx; padding: 32rpx; border-radius: 24rpx; background: #fff; box-shadow: 0 8rpx 26rpx rgba(43,48,42,.04); }
.section-heading { display: flex; align-items: center; justify-content: space-between; font-size: 33rpx; font-weight: 600; }
.section-count { color: #9ba69c; font-size: 22rpx; font-weight: 400; }
.create-row { display: flex; gap: 16rpx; margin-top: 26rpx; }
.text-input, .join-input { box-sizing: border-box; height: 82rpx; padding: 0 22rpx; border: 1rpx solid #dfe6de; border-radius: 14rpx; background: #fbfcfa; font-size: 27rpx; }
.text-input { flex: 1; min-width: 0; }
.small-button { flex: none; margin: 0; padding: 0 28rpx; line-height: 82rpx; border-radius: 14rpx; color: #fff; background: #476b55; font-size: 27rpx; }
.small-button[disabled] { opacity: .52; }
.ledger-row { display: flex; align-items: center; gap: 18rpx; min-height: 104rpx; padding: 2rpx 6rpx; border-bottom: 1rpx solid #eef1ed; }
.ledger-row:last-child { border-bottom: none; }
.ledger-mark { display: flex; align-items: center; justify-content: center; width: 64rpx; height: 64rpx; border-radius: 16rpx; background: #ebf1eb; color: #476b55; font-size: 26rpx; }
.shared-mark { background: #f7ede8; color: #aa7053; }
.ledger-name { flex: 1; font-size: 29rpx; }
.ledger-info { flex: 1; min-width: 0; padding: 14rpx 0; }
.ledger-owner { margin-top: 6rpx; color: #89948b; font-size: 23rpx; }
.ledger-action { color: #919b91; font-size: 24rpx; }
.selected .ledger-action { color: #476b55; font-weight: 600; }
.empty, .list-foot { padding: 34rpx 0 10rpx; color: #98a098; font-size: 25rpx; text-align: center; }
.empty-symbol { display: flex; align-items: center; justify-content: center; width: 76rpx; height: 76rpx; margin: 0 auto 16rpx; border-radius: 50%; background: #eef4ee; color: #527a60; font-size: 40rpx; }
.shared-symbol { background: #faf0e9; color: #a87558; }
.empty-tip { margin-top: 7rpx; color: #adb5ab; font-size: 22rpx; }
.hint { margin-top: 12rpx; color: #89948b; font-size: 24rpx; }
.join-input { width: 100%; margin-top: 24rpx; }
.quiet-button { margin-top: 22rpx; min-height: 88rpx; border-radius: 14rpx; color: #476b55; border: 1rpx solid #c9d7ca; background: #f7faf7; }
.error { margin: 20rpx 4rpx; color: #ad5548; font-size: 25rpx; word-break: break-all; }

/* Figma 礼簿视觉规范：纸张底色、松绿主色、暖金点缀。 */
page { background: #f6f4ee; }
.page { padding: 26rpx 46rpx 118rpx; color: #223329; }
.hero { padding: 0 0 26rpx; }
.title { margin: 0; font-size: 50rpx; font-weight: 700; letter-spacing: 1rpx; }
.subtitle { margin-top: 6rpx; color: #758278; font-size: 24rpx; }
.current-card { margin-top: 0; padding: 42rpx; border-radius: 44rpx; background: #244e3b; box-shadow: none; }
.current-card::after { display: none; }
.current-label, .quick-summary text:first-child { color: #d9b986; }
.current-tag { background: rgba(255,255,255,.12); }
.current-name { margin-top: 24rpx; font-size: 52rpx; font-weight: 700; }
.current-hint, .current-owner { color: #e6eee6; }
.quick-summary { margin-top: 34rpx; padding-top: 22rpx; border-color: rgba(255,255,255,.18); }
.quick-summary text:last-child { font-size: 26rpx; }
.primary-button { margin-top: 26rpx; min-height: 92rpx; border-radius: 27rpx; color: #fff; background: #244e3b; font-size: 29rpx; }
.card { margin-top: 26rpx; padding: 34rpx; border-radius: 35rpx; box-shadow: none; }
.section-heading { font-size: 32rpx; }
.section-count, .empty, .list-foot, .hint, .ledger-owner { color: #758278; }
.text-input, .join-input { border: none; border-radius: 19rpx; background: #f6f4ee; }
.small-button { border-radius: 19rpx; background: #244e3b; }
.small-button { height: 82rpx; }
.ledger-row { border-color: #e3e8e1; }
.ledger-mark { background: #e6eee6; color: #244e3b; }
.ledger-action, .selected .ledger-action { color: #244e3b; }
.quiet-button { border: none; background: #e6eee6; color: #244e3b; }
