<view class="page">
  <view class="title">{{ledgerName}}</view>
  <view class="subtitle">记录每一笔收礼与送礼</view>

  <view class="card">
    <view class="section-title">新增记录</view>
    <view class="direction-row">
      <view class="direction-option {{direction === 'received' ? 'active' : ''}}" data-direction="received" bindtap="chooseDirection">收礼</view>
      <view class="direction-option {{direction === 'given' ? 'active' : ''}}" data-direction="given" bindtap="chooseDirection">送礼</view>
    </view>

    <view class="field-label">往来对象</view>
    <input class="field-input" value="{{personName}}" maxlength="40" placeholder="例如：张先生" bindinput="onPersonNameInput" />

    <view class="field-label">金额（元）</view>
    <input class="field-input" type="digit" value="{{amount}}" placeholder="例如：500.00" bindinput="onAmountInput" />

    <view class="field-label">日期</view>
    <picker mode="date" value="{{happenedOn}}" bindchange="onDateChange">
      <view class="field-input date-field">{{happenedOn}}</view>
    </picker>

    <view class="field-label">备注（可选）</view>
    <textarea class="note-input" value="{{note}}" maxlength="200" placeholder="例如：婚礼礼金" bindinput="onNoteInput"></textarea>

    <button class="save-button" type="primary" loading="{{saving}}" disabled="{{saving || listLoading}}" bindtap="createEntry">保存记录</button>
  </view>

  <view class="card records-card">
    <view class="section-title">往来记录</view>
    <view wx:if="{{error}}" class="error">{{error}}</view>
    <view wx:if="{{!entries.length && !listLoading && !error}}" class="empty">这个账本还没有记录。</view>
    <view wx:for="{{entries}}" wx:key="id" class="entry-row">
      <view class="entry-main">
        <text class="entry-person">{{item.personName}}</text>
        <text class="entry-date">{{item.happenedOn}}</text>
      </view>
      <view class="entry-side">
        <text class="entry-amount {{item.direction === 'received' ? 'received' : 'given'}}">{{item.directionLabel}} ¥{{item.amountYuan}}</text>
        <text wx:if="{{item.note}}" class="entry-note">{{item.note}}</text>
      </view>
    </view>
    <view wx:if="{{listLoading}}" class="list-foot">加载中…</view>
    <view wx:elif="{{hasMore && entries.length}}" class="list-foot" bindtap="loadMore">加载更多</view>
  </view>
</view>
